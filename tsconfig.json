{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2019", "DOM"],
    "types": ["vitest/globals", "jsdom"]
  },
  "include": ["src/**/*.ts", "lib/**/*.ts", "config/**/*.ts", "types/**/*.ts", "tests/**/*.ts", "demo/**/*.html"]
}
